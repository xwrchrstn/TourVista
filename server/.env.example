# The capstone runs locally without MySQL by default. Uncomment to select MySQL.
# DEMO_MODE=false
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tourvista_app
DB_PASSWORD="REPLACE_WITH_YOUR_LOCAL_PASSWORD"
DB_NAME=tourvista_capstone

# Optional: use a saved, operator-validated Claveria OpenStreetMap export.
# ROAD_SNAPSHOT_PATH=storage/roads/claveria-overpass.json
# Optional: configure an OSRM server for the driving preview. The default is the public FOSSGIS demo.
# DRIVING_ROUTER_URL=http://127.0.0.1:5000
# TOURVISTA_BACKUP_DIR=storage/backups

# Run npm.cmd run email:setup from the project root to connect the sender.
APP_URL=http://127.0.0.1:5173
# Later: use MAIL_MODE=smtp and the trusted public HTTPS APP_URL.
# MAIL_FROM="TourVista <your-verified-sender@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS="your-provider-app-password"
